ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: LangSmith tracing for the LangGraph agent loop. Leave TRACING_V2
# as false (or unset) to disable — the graph runs identically either way.
LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=care-plan-system